# Copy to .env (and load it yourself, e.g. with `node --env-file=.env server.js`
# on Node 20.6+, or the `dotenv` package) — or just export these in your shell.

# Comma-separated list of valid API keys. Required unless RXCHECK_ALLOW_NO_AUTH=true.
RXCHECK_API_KEYS=dev-key-123,another-key-456

# Set to "true" ONLY for local development to skip auth entirely. Never set
# this in a deployed environment.
RXCHECK_ALLOW_NO_AUTH=false

# Requests allowed per API key per window.
RXCHECK_RATE_LIMIT=60

# Window size in milliseconds (default: 60000 = 1 minute).
RXCHECK_RATE_WINDOW_MS=60000

PORT=3000
