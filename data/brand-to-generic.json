  "_meta": {
    "description": "SEED/STARTER dataset. Maps common Indian pharmaceutical brand names to their generic (INN) ingredient(s). This is a small, manually curated list of widely known brands intended to bootstrap the project \u2014 it is NOT exhaustive and NOT a substitute for an authoritative source (e.g. CDSCO drug database, a licensed drug compendium, or a pharmacist). Brand availability, formulations, and strengths change over time and vary by manufacturer. Verify before any clinical or production use. Contributions to expand/correct this file are welcome. Batch 2 (2026-10): ~48 additional common Indian brands added, same curation standard and same caveats \u2014 not exhaustive, needs clinical verification.",
    "lastReviewed": "2026-10 (batch 2 added)",
    "schema": {
      "brand": "Brand name as commonly seen on packaging/prescriptions (case-insensitive lookup)",
      "genericNames": "Array of generic/INN ingredient names. More than one entry means a combination product.",
      "combination": "true if the brand is a fixed-dose combination of 2+ actives",
      "notes": "Optional free-text notes (common strengths, category)"
    }
  },
